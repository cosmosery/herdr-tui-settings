+    fn move_navigator_machine(&mut self, forward: bool) {
+        let Some(ClientShellOverlay::Navigator(navigator)) = self.overlay.as_mut() else {
+            return;
+        };
+        let rows =
+            render::client_navigator_rows(&self.endpoints, &self.active_endpoint_id, navigator);
+        let Some(selected) =
+            super::aggregate_navigation::navigator_selected_index(&rows, navigator)
+        else {
+            return;
+        };
+        let is_machine =
+            |row: &ClientNavigatorRow| matches!(row.target, ClientNavigatorTarget::Machine { .. });
+        let destination = if forward {
+            rows[selected + 1..].iter().find(|row| is_machine(row))
+        } else {
+            rows[..=selected]
+                .iter()
+                .rev()
+                .filter(|row| is_machine(row))
+                .nth(1)
+        };
+        if let Some(row) = destination {
+            navigator.selected = Some(row.target.clone());
+        }
+    }
